# AI Provider Configuration
# Supported providers: gemini, openai, mock
AI_PROVIDER=gemini
AI_MODEL=gemini-2.5-flash

# API Keys (Provide the key for your chosen provider)
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Application Configuration
APP_ENV=development
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:5173,http://localhost:8443,http://127.0.0.1:5173,http://127.0.0.1:8443

# Database
DATABASE_URL=sqlite:///./interview_assistant.db
